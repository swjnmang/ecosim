# Supabase-Projekt (EU-Region, z.B. Frankfurt) – siehe SETUP.md
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Postgres-Verbindungen für Prisma (aus Supabase: Project Settings -> Database -> Connection string)
# DATABASE_URL: "Transaction" Pooler-Verbindung (Port 6543) - für die App zur Laufzeit
DATABASE_URL=postgresql://postgres.xxxxx:PASSWORT@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL: direkte Verbindung (Port 5432) - nur für Prisma Migrate
DIRECT_URL=postgresql://postgres.xxxxx:PASSWORT@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
