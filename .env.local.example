# Supabase-Projekt (EU-Region, z.B. Frankfurt) – siehe SETUP.md
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Direkte Postgres-Verbindung für Prisma (aus Supabase: Project Settings -> Database)
DATABASE_URL=postgresql://postgres:PASSWORT@db.xxxxx.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:PASSWORT@db.xxxxx.supabase.co:5432/postgres
